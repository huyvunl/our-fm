# Shared office passcode, at least 8 characters
OFFICE_PASSCODE=change-me-please
# Spotify app credentials (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
# Must match a redirect URI registered in the Spotify app
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/auth/callback
# Optional: exact Spotify device name (falls back to the first available device)
SPOTIFY_DEVICE_NAME=
# Optional: SQLite file path (Railway: /data/our-fm.db)
DB_PATH=./data/our-fm.db
# Optional: HTTP port (Railway sets it)
PORT=3000
# Optional: votes needed to skip (default 3, or 2 if the requester votes). 1 = anyone skips alone
SKIP_VOTES=
